              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 24px",
                "@media (max-width: 768px)": {
                  "padding": "0 16px"
                }
              }
            },
            ".container": {
              "@media (max-width: 768px)": {
                "padding": "0 16px"
              }
            },
            ".row": {
              "justify-content": "center",
              "position": "relative",
              "z-index": "1"
