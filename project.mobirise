    "glasreinigung.html": {
      "settings": {
        "title": "Glasreinigung | Professionelle Glasreinigung – Streifenfreie Sauberkeit für Ihre Fenster",
        "meta_descr": "ATM Gebäudereinigung bietet gründliche Glas- & Fensterreinigung für klare Sicht & makellosen Glanz. Streifenfrei, zuverlässig & umweltfreundlich. Jetzt Termin sichern!",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "meta_image": "@PROJECT_PATH@/assets/images/social-logo.png-787x284.png",
