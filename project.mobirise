        {
          "_name": "numbers1",
          "_sourceTheme": "creatorm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"numbers1\" group=\"Numbers\">\n   <mbr-parameters>\n      <!-- Block parameters controls (Blue \"Gear\" panel) -->\n      <header>Size</header>\n      <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n      <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"5\">\n      <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"5\">\n      <header>Show/Hide</header>\n      <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n      <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n      <input type=\"checkbox\" title=\"Button\" name=\"showButton\">\n      <select title=\"Amount\" name=\"itemsAmount\">\n         <option value=\"2\">2</option>\n         <option value=\"3\">3</option>\n         <option value=\"4\" selected>4</option>\n         <option value=\"5\">5</option>\n     </select>\n      <input type=\"color\" title=\"Accent 1 Color\" name=\"accent1\" value=\"#fedb01\">\n      <input type=\"color\" title=\"Accent 2 Color\" name=\"accent2\" value=\"#6c38ff\">\n      <input type=\"color\" title=\"Accent 3 Color\" name=\"accent3\" value=\"#ff4433\" condition=\"itemsAmount > 2\">\n      <input type=\"color\" title=\"Accent 4 Color\" name=\"accent4\" value=\"#ff9417\" condition=\"itemsAmount > 3\">\n      <input type=\"color\" title=\"Accent 5 Color\" name=\"accent5\" value=\"#4cc9f0\" condition=\"itemsAmount > 4\">\n      <header>Background</header>\n      <fieldset type=\"background\" name=\"bg\">\n         <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/creatorm5/components/_images/background1.jpg\">\n         <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n      </fieldset>\n\n      <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n      <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n      <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n      <!-- End block parameters -->\n   </mbr-parameters>\n\n   <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n   </div>\n\n   <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n      <div class=\"main\">\n         <div class=\"row title-block\" mbr-if=\"showTitle || showSubtitle\">\n            <div class=\"col-12\">\n               <h4 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\" mbr-if=\"showTitle\"><b>Unsere zufriedenen Kunden</b></h4>\n               <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\">Qualität bestimmt die Zufriedenheit unserer Kunden. Deshalb sorgen wir dafür, dass jeder unserer Kunden bestmöglich versorgt wird. Denn nur die beste Reinigung und Instandhaltung Ihrer Immobilie ist uns genug. Dies macht sich an der Anzahl unserer Kunden und unserer Einsätze bemerkbar. Und deshalb wird uns ein großes Vertrauen geschenkt.</h3>\n            </div>\n         </div>\n         <div class=\"timeline row\">           \n            <div class=\"line1\"></div>\n            <div class=\"year col\">\n               <div class=\"accent accent1\"></div>\n               <h4 class=\"year-title year1 mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".year-title\">\n                  <b>8.200+</b></h4>\n               <h3 class=\"year-subtitle mbr-fonts-style\" data-app-selector=\".year-subtitle\" mbr-theme-style=\"display-7\">\n                  Einsätze</h3>\n            </div>\n            <div class=\"line\" mbr-if=\"itemsAmount > 1\"></div>\n            <div class=\"year col\" mbr-if=\"itemsAmount > 1\">\n               <div class=\"accent accent2\"></div>\n               <h4 class=\"year-title year2 mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".year-title\">\n                  <b>95+</b></h4>\n               <h3 class=\"year-subtitle mbr-fonts-style\" data-app-selector=\".year-subtitle\" mbr-theme-style=\"display-7\">\n                  Stammkunden</h3>\n            </div>\n            <div class=\"line\" mbr-if=\"itemsAmount > 2\"></div>\n            <div class=\"year col\" mbr-if=\"itemsAmount > 2\">\n               <div class=\"accent accent3\"></div>\n               <h4 class=\"year-title year3 mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".year-title\">\n                  <b>40+</b></h4>\n               <h3 class=\"year-subtitle mbr-fonts-style\" data-app-selector=\".year-subtitle\" mbr-theme-style=\"display-7\">Wöchentliche Einsätze\n<div><br></div></h3>\n            </div>\n            <div class=\"line\" mbr-if=\"itemsAmount > 3\"></div>\n            <div class=\"year col\" mbr-if=\"itemsAmount > 3\">\n               <div class=\"accent accent4\"></div>\n               <h4 class=\"year-title year4 mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".year-title\">\n                  <b>53</b></h4>\n               <h3 class=\"year-subtitle mbr-fonts-style\" data-app-selector=\".year-subtitle\" mbr-theme-style=\"display-7\">5 Sterne Bewertung</h3>\n            </div>\n            <div class=\"line\" mbr-if=\"itemsAmount > 4\"></div>\n            <div class=\"year col\" mbr-if=\"itemsAmount > 4\">\n               <div class=\"accent accent5\"></div>\n               <h4 class=\"year-title year5 mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".year-title\">\n                  <b>2021</b></h4>\n               <h3 class=\"year-subtitle no-padd mbr-fonts-style\" data-app-selector=\".year-subtitle\" mbr-theme-style=\"display-7\">\n                  250th video released</h3>\n            </div>         \n         </div>\n      </div>\n      <div class=\"button-align\" mbr-if=\"showButton\">\n         <div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-4\">\n            <a class=\"btn btn-primary\" href data-app-placeholder=\"Type Text\">Subscribe</a></div>\n      </div>\n   </div>\n</section>",
