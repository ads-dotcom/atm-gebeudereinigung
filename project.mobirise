    "kontakt.html": {
      "settings": {
        "title": "Kontakt | ATM Gebäudereinigung | Jetzt Anfrage senden",
        "meta_descr": "Kontaktieren Sie ATM Gebäudereinigung für professionelle Reinigungsdienstleistungen. Wir sind per Telefon, E-Mail oder Kontaktformular für Sie erreichbar!",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "meta_image": "@PROJECT_PATH@/assets/images/social-logo.png-787x284.png",
        "order": "21"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
