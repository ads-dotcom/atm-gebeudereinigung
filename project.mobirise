        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "<!-- Type valid HTML here -->\n\n<div>\n    <h1 class=\"display-1\" id=\"form\"></h1>\n    [JS_CODE_0]\n    <p class=\"display-3\"></p>\n</div>",
          "_customCSS": "/* Type valid CSS here */\n\ndiv {\n    max-width:1170px;\n    width:90%;\n    margin:auto;\n  padding: 10px 10px;\n  color: #777;\n  text-align: center;\n}\n\n.display-1{\n    font-size:32px;\n}\n\np {\n  font-size: 16px;\n  color: #777;\n}\n\n@media screen and (max-width:521px){\n    div{\n        padding:0px 0px;\n    }\n}",
          "alias": "code-editor",
          "_tags": [
            "Extension"
          ],
          "_name": "pro.custom-html",
          "_sourceTheme": "mobirise5",
